# Copie ce fichier en .env et remplis tes vraies valeurs.
# Ne jamais committer le .env réel dans git.

# Clé API Claude — nécessaire pour que le générateur tourne seul,
# indépendamment de nos échanges dans Claude Code.
# À récupérer sur console.anthropic.com
ANTHROPIC_API_KEY=

# Renseignés à l'étape suivante, quand on branchera la base de données.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
