{
  "name": "brief-app-functions",
  "version": "0.0.1",
  "private": true,
  "description": "Moteur de génération du brief quotidien — un job par sujet, une fois par jour.",
  "type": "commonjs",
  "scripts": {
    "generate": "tsx --env-file=.env src/generateTopic.ts",
    "generate:all": "tsx --env-file=.env src/generateAll.ts",
    "notify": "tsx --env-file=.env src/sendNotifications.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@supabase/supabase-js": "^2.112.4"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
